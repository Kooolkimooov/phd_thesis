@article{o.aFiniteElementCablemodel2018,
  title = {Finite Element Cable-Model for {{Remotely Operated Vehicles}} ({{ROVs}}) by Application of Beam Theory},
  author = {O.A, N{\o}rve Eidsvik and Schj{\o}lberg, I.},
  year = {2018},
  month = sep,
  journal = {Ocean Engineering},
  volume = {163},
  pages = {322--336},
  issn = {0029-8018},
  doi = {10.1016/j.oceaneng.2018.06.012},
  abstract = {Increasing autonomy, efficiency and safety for Remotely Operated Vehicles (ROVs) is crucial for future subsea operations and requires accurate models for optimal control, operations and design. This involves precise modeling of the cable in conjunction with the ROV response. This paper presents a novel three-dimensional cable model for Remotely Operated Vehicles using Euler-Bernoulli beam theory. The presented model is implemented in Matlab and takes into account the most important effects related to the response of underwater cables and ROVs. Following beam theory bending stiffness is also included, making the model applicable for low tension scenarios. The presented model is modified to allow for compression of the cable. The resulting non-linear equations are discretized spatially by the Galerkin finite element method and solved temporally by the Newmark-{$\beta$} time integration scheme. The model is verified experimentally in ocean tank experiments on a real ROV system. A numerical example is presented and the results are compared to previous published results. Lastly, a sensitivity analysis for the hydrodynamic parameters is presented.},
  langid = {english},
  keywords = {Cable dynamics,Dynamic modeling,Finite element,ROV,Simulation},
  file = {C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\IDH36UZ7\\Nørve Eidsvik et Schjølberg - 2018 - Finite element cable-model for Remotely Operated V.pdf;C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\RCA6CUGU\\S002980181831014X.html}
}

@inproceedings{omandam3DLocalizationSuspended2022,
  title = {{{3D Localization}} of {{Suspended}} and {{Tethered Drone}} for {{High-rise Bridge Inspection}}},
