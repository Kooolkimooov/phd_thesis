@article{heshmati-alamdariRobustPredictiveControl2020,
  title = {A {{Robust Predictive Control Approach}} for {{Underwater Robotic Vehicles}}},
  author = {{Heshmati-Alamdari}, Shahab and Karras, George C. and Marantos, Panos and Kyriakopoulos, Kostas J.},
