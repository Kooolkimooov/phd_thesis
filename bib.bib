@article{guoNumericalInvestigationQuasistatic2021,
  title = {A Numerical Investigation on Quasi-Static Configuration and Nonlinear Dynamic Response Characteristics of Marine Towing Cable},
  author = {Guo, Li and Yuan, Yuchao and Tang, Wenyong and Xue, Hongxiang},
  year = {2021},
