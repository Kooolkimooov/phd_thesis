@inproceedings{murtraIMUCableEncoder2013,
  title = {{{IMU}} and Cable Encoder Data Fusion for In-Pipe Mobile Robot Localization},
  booktitle = {2013 {{IEEE Conference}} on {{Technologies}} for {{Practical Robot Applications}} ({{TePRA}})},
  author = {Murtra, A. C. and {Mirats-Tur}, J. M.},
