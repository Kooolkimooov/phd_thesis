@article{shenAerialRobotsCarrying2025,
  title = {Aerial {{Robots Carrying Flexible Cables}}: {{Dynamic Shape Optimal Control}} via {{Spectral Method Model}}},
  shorttitle = {Aerial {{Robots Carrying Flexible Cables}}},
  author = {Shen, Yaolei and Franchi, Antonio and Gabellieri, Chiara},
  year = {2025},
  journal = {IEEE Transactions on Robotics},
  pages = {1--20},
  issn = {1941-0468},
  doi = {10.1109/TRO.2025.3562459},
  urldate = {2025-05-12},
  abstract = {In this work, we present a model-based optimal boundary control design for an aerial robotic system composed of a quadrotor carrying a flexible cable. The whole system is modeled by partial differential equations (PDEs) combined with boundary conditions described by ordinary differential equations (ODEs). The proper orthogonal decomposition (POD) method is adopted to project the original infinite-dimensional system on a finite low-dimensional space spanned by orthogonal basis functions. Based on such a reduced order model, nonlinear model predictive control (NMPC) is implemented online to realize both position and shape trajectory tracking of the flexible cable in an optimal predictive fashion. The proposed POD-based reduced modeling and optimal control paradigms are verified in simulation using an accurate high-dimensional finite difference method- (FDM) based model and experimentally using a real quadrotor and a cable. The results show the viability of the POD-based predictive control approach (allowing to close the control loop on the full system state) and its superior performance compared to an optimally tuned PID controller (allowing to close the control loop on the quadrotor state only).},
  keywords = {Adaptation models,Aerial manipulation,aerial systems,Aerodynamics,Cables,Gravity,Load modeling,Mathematical models,mechanics and control,mobile manipulation,motion control,Quadrotors,Shape,Transportation,Vehicle dynamics},
  file = {C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\JE8DEIMI\\Shen et al. - 2025 - Aerial Robots Carrying Flexible Cables Dynamic Shape Optimal Control via Spectral Method Model.pdf;C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\598S8I2G\\10969810.html}
}

@article{shenDistributedImplementationNonlinear2020,
  title = {Distributed Implementation of Nonlinear Model Predictive Control for {{AUV}} Trajectory Tracking},
  author = {Shen, Chao and Shi, Yang},
  year = {2020},
  month = may,
  journal = {Automatica},
  volume = {115},
  pages = {108863},
  issn = {0005-1098},
  doi = {10.1016/j.automatica.2020.108863},
  urldate = {2024-12-17},
  abstract = {This paper studies the trajectory tracking control of an autonomous underwater vehicle (AUV). We investigate the nonlinear model predictive control (NMPC) method looking for possible approaches to alleviate the heavy computational burden. Novel distributed NMPC algorithms are developed exploiting the dynamic properties of the AUV motion. By appropriately decomposing the original optimization problems into smaller size subproblems and then solving them in a distributed manner, the expected floating point operations (flops) can be reduced dramatically. We show that the convergence of the AUV trajectory can be guaranteed by the proposed contraction constraints in the decomposed subproblems. Recursive feasibility and closed-loop stability are proved. Taking advantage of the guaranteed stability, a real-time distributed implementation algorithm is further developed to automatically trade off between control performance and computational complexity. Extensive simulation studies on the Falcon AUV model demonstrate the effectiveness and robustness of the proposed approach.},
  keywords = {Autonomous underwater vehicle,Distributed control,Model predictive control,Nonlinear control,Real-time control,Trajectory tracking},
  file = {C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\IKJ5ZFG7\\Shen et Shi - 2020 - Distributed implementation of nonlinear model predictive control for AUV trajectory tracking.pdf;C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\ARLPZGCN\\S0005109820300613.html}
}

@article{shenIntegratedPathPlanning2017,
  title = {Integrated {{Path Planning}} and {{Tracking Control}} of an {{AUV}}: {{A Unified Receding Horizon Optimization Approach}}},
  shorttitle = {Integrated {{Path Planning}} and {{Tracking Control}} of an {{AUV}}},
  author = {Shen, Chao and Shi, Yang and Buckham, Brad},
