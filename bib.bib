@inproceedings{dueckerMicroRobotHydrobatics2020,
  title = {Towards {{Micro Robot Hydrobatics}}: {{Vision-based Guidance}}, {{Navigation}}, and {{Control}} for {{Agile Underwater Vehicles}} in {{Confined Environments}}},
  shorttitle = {Towards {{Micro Robot Hydrobatics}}},
  booktitle = {2020 {{IEEE}}/{{RSJ International Conference}} on {{Intelligent Robots}} and {{Systems}} ({{IROS}})},
  author = {Duecker, Daniel A and Bauschmann, Nathalie and Hansen, Tim and Kreuzer, Edwin and Seifried, Robert},
