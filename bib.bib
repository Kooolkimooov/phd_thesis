@inproceedings{mccammonPlanningExecutingOptimal2017,
  title = {Planning and Executing Optimal Non-Entangling Paths for Tethered Underwater Vehicles},
  booktitle = {2017 {{IEEE International Conference}} on {{Robotics}} and {{Automation}} ({{ICRA}})},
  author = {McCammon, Seth and Hollinger, Geoffrey A.},
  year = {2017},
  month = may,
  pages = {3040--3046},
  doi = {10.1109/ICRA.2017.7989349},
  abstract = {In this paper, we present a method to improve the navigation of tethered underwater vehicles by computing optimal paths that prevent their tethers from becoming entangled in obstacles. To accomplish this, we define the Non-Entangling Travelling Salesperson Problem (NE-TSP) as an extension of the Travelling Salesperson Problem with a non-entangling constraint. We compute the optimal solution to the NE-TSP by constructing a Mixed Integer Programming model, leveraging homotopy augmented graphs to plan an optimal trajectory through a set of inspection points, while maintaining a non-entangling guarantee. To avoid the computational expense of computing an optimal solution to the NE-TSP, we also introduce several methods to compute near-optimal solutions. In a set of simulated trials, our method was able to plan optimal non-entangling paths through a variety of environments. These results were then validated in a set of pool and field trials using a Seabotix vLBV300 underwater vehicle. The paths generated by our method were then compared to human-generated paths.},
  keywords = {Computational modeling,Inspection,Planning,Service robots,Trajectory,Underwater vehicles},
  file = {C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\5HRX8F49\\McCammon et Hollinger - 2017 - Planning and executing optimal non-entangling path.pdf;C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\27BLJ4NR\\7989349.html}
}

@article{mcgareyTSLAMTetheredSimultaneous2017,
  title = {{{TSLAM}}: {{Tethered}} Simultaneous Localization and Mapping for Mobile Robots},
  shorttitle = {{{TSLAM}}},
  author = {McGarey, P. and MacTavish, K. and Pomerleau, F. and Barfoot, D.T.},
  year = {2017},
  month = oct,
  journal = {The International Journal of Robotics Research},
  volume = {36},
  number = {12},
  pages = {1363--1386},
  publisher = {SAGE Publications Ltd STM},
  issn = {0278-3649},
  doi = {10.1177/0278364917732639},
  abstract = {Tethered mobile robots are useful for exploration in steep, rugged, and dangerous terrain. A tether can provide a robot with robust communications, power, and mechanical support, but also constrains motion. In cluttered environments, the tether will wrap around a number of intermediate `anchor points', complicating navigation. We show that by measuring the length of tether deployed and the bearing to the most recent anchor point, we can formulate a tethered simultaneous localization and mapping (TSLAM) problem that allows us to estimate the pose of the robot and the positions of the anchor points, using only low-cost, nonvisual sensors. This information is used by the robot to safely return along an outgoing trajectory while avoiding tether entanglement. We are motivated by TSLAM as a building block to aid conventional, camera, and laser-based approaches to simultaneous localization and mapping (SLAM), which tend to fail in dark and or dusty environments. Unlike conventional range-bearing SLAM, the TSLAM problem must account for the fact that the tether-length measurements are a function of the robot's pose and all the intermediate anchor-point positions. While this fact has implications on the sparsity that can be exploited in our method, we show that a solution to the TSLAM problem can still be found and formulate two approaches: (i) an online particle filter based on FastSLAM and (ii) an efficient, offline batch solution. We demonstrate that either method outperforms odometry alone, both in simulation and in experiments using our TReX (Tethered Robotic eXplorer) mobile robot operating in flat-indoor and steep-outdoor environments. For the indoor experiment, we compare each method using the same dataset with ground truth, showing that batch TSLAM outperforms particle-filter TSLAM in localization and mapping accuracy, owing to superior anchor-point detection, data association, and outlier rejection.},
  langid = {english},
  file = {C:\Users\Martin\OneDrive - Université de Toulon\Thèse\Bibliographie\Zotero\storage\JQK8SQ58\McGarey et al. - 2017 - TSLAM Tethered simultaneous localization and mapp.pdf}
}

@article{mengDynamicsCalculationComplex2020,
