@unpublished{vielEllipsoidTetherModel2024a,
  title = {Ellipsoid Tether Model for Collision Avoidance in a Fleet of {{ROVs}} - {{Full}} Version},
  author = {Viel, Christophe},
  year = {2024},
  month = oct,
  urldate = {2025-06-10},
  abstract = {During collision avoidance, the tether of Remote Operated Vehicle (ROV) is subject to entanglement with obstacles or other ROVs' tether. This specificity means that the classic literature on multi-robot obstacles avoidance is not suitable to tethered multi-robot scenarios. This paper proposes a guarantee ellipsoid model of the ROV's tether and its obstacles to perform a collision avoidance method for a fleet of ROVs, low in calculation. This model guarantees that if an obstacle is not inside or partially inside the ellipsoid model, then we are sure that the tether is not collide with that obstacle. This model is simple and can provide a guaranteed proof of non-collision without any knowledge of the tether shape or its dynamic, only its two attachments point and its length. A collision avoidance strategy has been developed based on potential field methods, tether's length management, and bypass path. When several ROVs are involved, personalities are added to ROV to obtain different behaviors in the same configuration and so limit the case of minimal local during collision avoidance. Simulations show the effectiveness of the method with several scenarios and the limits of the method are discussed.},
  keywords = {cable modeling,collision avoidance,mutli-agent system,ROV,tether,umbilical},
  file = {C:\Users\Martin\OneDrive - Université de Toulon\Thèse\Bibliographie\Zotero\storage\Q4BC2IFG\Viel - 2024 - Ellipsoid tether model for collision avoidance in a fleet of ROVs - Full version.pdf}
}

@article{vielROVLocalizationBased2023,
  title = {{{ROV}} Localization Based on Umbilical Angle Measurement},
  author = {Viel, Christophe and Drupt, Juliette and Dune, Claire and Hugel, Vincent},
  year = {2023},
  month = feb,
  journal = {Ocean Engineering},
  volume = {269},
  pages = {113570},
  issn = {0029-8018},
  doi = {10.1016/j.oceaneng.2022.113570},
  abstract = {If the umbilical of Remote Operated Vehicle (ROV) allows the transmission of information in real time or the supply of energy to the robot, it also has many disadvantages such as entanglement or the difficulty of predicting its shape, which raises the question of being able to do without it. In order to turn these constraints into advantages, this paper proposes a method to estimate the position of an ROV by observing the shape of its umbilical. The umbilical is equipped with moving ballasts and buoys to give it a predictable shape with straight lines: simple mathematical models of the umbilical can thus be defined. Using these models and measuring the angles at the ends of the cable, the position of the ROV can be found. Three umbilical models with different equipment are proposed. The methods were tested in a pool and the estimated position of the ROV was compared with its actual position measured using a motion capture system.},
  langid = {english},
  keywords = {Cables model,Localization system,Underwater robotics},
  file = {C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\MFCT7LCA\\Viel et al. - 2023 - ROV localization based on umbilical angle measurem.pdf;C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\E48PZQ3Q\\S0029801822028530.html}
}

@article{vielSelfManagementROVUmbilical2022,
  title = {Self-{{Management}} of {{ROV Umbilical Using Sliding Buoys}} and {{Stop}}},
  author = {Viel, C.},
  year = {2022},
  month = jul,
  journal = {IEEE Robotics and Automation Letters},
  volume = {7},
  number = {3},
  pages = {8061--8068},
  issn = {2377-3766},
  doi = {10.1109/lra.2022.3187267},
  abstract = {The umbilical of Remote Operated Vehicle (ROV) has two main problems: it is subject to entanglement with obstacles or itself, and its shape is difficult to predict for the navigation. To address these issues, this article proposes a passive self-management of an ROV's umbilical, suitable for underwater and seafloor exploration. By adding two buoys moving freely on the umbilical, the described method avoids self-entanglement of the cable by stretching it, and gives it a predictable shape. A fast time computational model of the cable is proposed to provide feedback to the operator. The buoys move on their own to keep the cable taut without a motorized system, making this method easy to adapt to existing ROVs with few constraints on their navigation. Simulations and experimentation in pool show the effectiveness of the method.},
  keywords = {Boats,cables management,Electronic ballasts,Floors,Marin robotics,Modeling,Real-time systems,Robots,Shape,Underwater cables,Underwater robotics},
  file = {C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\X2BPWS7F\\Viel - 2022 - Self-Management of ROV Umbilical Using Sliding Buo.pdf;C\:\\Users\\Martin\\OneDrive - Université de Toulon\\Thèse\\Bibliographie\\Zotero\\storage\\PDUF7HND\\9812510.html}
}

